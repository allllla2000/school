<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <changeSet id="add-student-name-index" author="alla">
        <createIndex indexName="idx_student_name" tableName="student">
            <column name="name"/>
        </createIndex>
    </changeSet>


    <changeSet id="add-faculty-name-color-index" author="alla">
        <createIndex indexName="idx_faculty_name_color" tableName="faculty">
            <column name="name"/>
            <column name="color"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>